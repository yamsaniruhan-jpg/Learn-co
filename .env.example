# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# Optional: when absent, AI features fall back to deterministic local engines.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Configurable Copilot Model Routing
COPILOT_MODEL="gemini-2.5-flash"
COPILOT_REASONING_MODEL="gemini-2.5-pro"
COPILOT_LONG_CONTEXT_MODEL="gemini-2.5-flash"
COPILOT_CODE_MODEL="gemini-2.5-flash"

# ---------------------------------------------------------------
# Optional: Firebase Admin (Firestore persistence)
# ---------------------------------------------------------------
# All of these are OPTIONAL. The application stores state in the local
# `.learnco_db.json` store and only mirrors to Firestore when credentials
# are available. Without them the server still starts and every API
# endpoint keeps working.
#
# GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/service-account.json"
# FIREBASE_PROJECT_ID="your-firebase-project-id"
# FIRESTORE_DATABASE_ID="your-named-firestore-database"
# Set to "true" to force-disable Firebase Admin even if credentials exist.
# FIREBASE_ADMIN_DISABLED="false"

# ---------------------------------------------------------------
# Optional: Stripe subscriptions
# ---------------------------------------------------------------
# Without these keys the subscription endpoints operate in sandbox mode
# (instant tier upgrade) instead of creating real Checkout sessions.
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PRO_PRICE_ID="price_..."
# STRIPE_SUPER_PRICE_ID="price_..."

# Password reset: use the public application origin, not a request-supplied URL.
# APP_URL="https://your-app.example"
# RESEND_API_KEY="your-resend-api-key"
# SMTP_URL="smtp://user:password@host:587"
# MAIL_FROM="LearnCo <no-reply@your-domain.example>"
# Without Resend or SMTP, reset links are written to the server log instead.

# Optional separate file for local data (especially tests and temporary previews).
# LEARNCO_DB_FILE="/absolute/path/to/learnco-data.json"

# ---------------------------------------------------------------
# PostgreSQL / Cloud SQL (Persistent users & mentor applications)
# ---------------------------------------------------------------
# Injected automatically when Cloud SQL is enabled in AI Studio.
# SQL_HOST="127.0.0.1"
# SQL_USER="your-db-user"
# SQL_PASSWORD="your-db-password"
# SQL_DB_NAME="your-db-name"
# SQL_ADMIN_USER="your-admin-user"
# SQL_ADMIN_PASSWORD="your-admin-password"

