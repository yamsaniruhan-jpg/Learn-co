# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# Optional: when absent, AI features fall back to deterministic local engines.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Configurable Copilot Model Routing
COPILOT_MODEL="gemini-2.5-flash"
COPILOT_REASONING_MODEL="gemini-2.5-pro"
COPILOT_LONG_CONTEXT_MODEL="gemini-2.5-flash"
COPILOT_CODE_MODEL="gemini-2.5-flash"

# ---------------------------------------------------------------
# Firebase client (public, build-time configuration)
# ---------------------------------------------------------------
# The committed firebase-applet-config.json is the default. To override its
# core settings, provide ALL FOUR values from the SAME Firebase web app before
# building with Vite. These values are public; never put credentials here.
# VITE_FIREBASE_API_KEY="your-web-api-key"
# VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
# VITE_FIREBASE_PROJECT_ID="your-firebase-project-id"
# VITE_FIREBASE_APP_ID="your-firebase-web-app-id"
# VITE_FIREBASE_STORAGE_BUCKET="your-bucket"
# VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
# VITE_FIREBASE_MEASUREMENT_ID="your-measurement-id"
# VITE_FIRESTORE_DATABASE_ID="your-named-firestore-database"
# If using another project, explicitly set its named database if needed;
# otherwise the default database is used. Rebuild after changes.
# See docs/google-sign-in.md for Google consent, authorized domains and Admin.

# ---------------------------------------------------------------
# Firebase Admin (server-side Google token verification and Firestore)
# ---------------------------------------------------------------
# The server can start without Admin credentials, but Google sign-in cannot
# create an application session until Firebase Admin is configured. The Admin
# project must match the client project. Local JSON fallback is available for
# tests or when explicitly enabled with LEARNCO_JSON_FALLBACK=true.
#
# GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/service-account.json"
# FIREBASE_PROJECT_ID="your-firebase-project-id"
# FIRESTORE_DATABASE_ID="your-named-firestore-database"
# Set to "true" to force-disable Firebase Admin even if credentials exist.
# FIREBASE_ADMIN_DISABLED="false"

# ---------------------------------------------------------------
# Optional: Stripe subscriptions
# ---------------------------------------------------------------
# Without these keys the subscription endpoints operate in sandbox mode
# (instant tier upgrade) instead of creating real Checkout sessions.
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PRO_PRICE_ID="price_..."
# STRIPE_SUPER_PRICE_ID="price_..."

# Password reset & mentorship emails: use the public application origin, not a request-supplied URL.
# APP_URL="https://your-app.example"
# RESEND_API_KEY="your-resend-api-key"
# GMAIL_USER="your-gmail-address@gmail.com"
# GMAIL_APP_PASSWORD="your-16-char-gmail-app-password"
# SMTP_URL="smtp://user:password@host:587"
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="your-smtp-user"
# SMTP_PASS="your-smtp-password"
# MAIL_FROM="LearnCo <no-reply@your-domain.example>"
# Without an email relay secret, password reset & automated emails are unavailable; reset links are never logged.

# Optional exact cross-origin browser clients, comma-separated. Same-origin
# deployments and proxied previews do not need this setting.
# CORS_ALLOWED_ORIGINS="https://staging.example.com"

# Optional separate file or local-dev JSON fallback (disabled when Cloud SQL is used).
# LEARNCO_JSON_FALLBACK="false"
# LEARNCO_DB_FILE="/absolute/path/to/learnco-data.json"

# ---------------------------------------------------------------
# PostgreSQL / Cloud SQL (Persistent users & mentor applications)
# ---------------------------------------------------------------
# Injected automatically when Cloud SQL is enabled in AI Studio.
# SQL_HOST="127.0.0.1"
# SQL_USER="your-db-user"
# SQL_PASSWORD="your-db-password"
# SQL_DB_NAME="your-db-name"
# SQL_ADMIN_USER="your-admin-user"
# SQL_ADMIN_PASSWORD="your-admin-password"

