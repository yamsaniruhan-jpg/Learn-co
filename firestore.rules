rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && isValidId(userId) && request.auth.uid == userId;
    }

    function isPlatformOwner() {
      return isAuthenticated()
        && request.auth.token.email == 'yamsaniruhan@gmail.com'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isValidPublicProfile(data, userId) {
      return data.userId == userId
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 120
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 1000))
        && (!('xp' in data) || (data.xp is number && data.xp >= 0 && data.xp <= 10000000))
        && (!('level' in data) || (data.level is number && data.level >= 1 && data.level <= 1000));
    }

    function isValidLeaderboardEntry(data, entryId) {
      return isValidId(entryId)
        && data.userId == request.auth.uid
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 120
        && data.xp is number && data.xp >= 0 && data.xp <= 10000000
        && data.level is number && data.level >= 1 && data.level <= 1000
        && (!('streak' in data) || (data.streak is number && data.streak >= 0 && data.streak <= 10000))
        && (!('streakDays' in data) || (data.streakDays is number && data.streakDays >= 0 && data.streakDays <= 10000));
    }

    // User private data
    match /users/{userId} {
      allow read: if isOwner(userId);
      // Billing and privilege fields are written by trusted server code only.
      // Allow an existing document with protected fields to receive an ordinary
      // profile merge, but prevent clients from adding, editing or removing them.
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny(['role', 'subscription', 'subscriptionExpiresAt', 'stripeCustomerId', 'stripeSubscriptionId', 'cancelledAt']);
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'subscription', 'subscriptionExpiresAt', 'stripeCustomerId', 'stripeSubscriptionId', 'cancelledAt']);
      // Client deletion could erase server-owned billing state. Account deletion
      // requires a server-managed process, not a direct document delete.
      allow delete: if false;

      match /progress/{courseId} {
        allow read, write: if isOwner(userId) && isValidId(courseId);
      }

      match /spacedRepetition/{cardId} {
        allow read, write: if isOwner(userId) && isValidId(cardId);
      }

      match /{subcollection}/{docId} {
        allow read, write: if isOwner(userId) && isValidId(docId);
      }
    }

    // Public scholar profiles (no PII; owner-only writes)
    match /public_profiles/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) && isValidPublicProfile(request.resource.data, userId);
      allow delete: if isOwner(userId);
    }

    // Leaderboard scores must only be written by trusted server code (Admin SDK).
    match /leaderboard/{entryId} {
      allow read: if true;
      allow write: if false;
    }

    // Creator resources
    match /resources/{resourceId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidId(resourceId) && (
        request.resource.data.creatorId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
      allow update, delete: if isAuthenticated() && isValidId(resourceId) && (
        resource.data.creatorId == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );
    }

    // Mentors catalog (owner-only or platform owner writes)
    match /mentors/{mentorId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidId(mentorId)
        && (request.resource.data.userId == request.auth.uid || isPlatformOwner());
      allow update, delete: if isAuthenticated() && isValidId(mentorId)
        && (resource.data.userId == request.auth.uid || mentorId == request.auth.uid || isPlatformOwner());
    }

    // Mentor applications (applicant create/read own, platform owner full review access)
    match /mentor_applications/{applicationId} {
      allow get, list: if isAuthenticated() && (
        resource.data.applicantUid == request.auth.uid ||
        isPlatformOwner()
      );
      allow create: if isAuthenticated() && isValidId(applicationId)
        && request.resource.data.applicantUid == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.routedToEmail == 'yamsaniruhan@gmail.com'
        && request.resource.data.fullName is string && request.resource.data.fullName.size() <= 160
        && request.resource.data.bio is string && request.resource.data.bio.size() <= 4000;
      allow update, delete: if isPlatformOwner();
    }

    // Mentorship sessions (participant-scoped)
    match /sessions/{sessionId} {
      allow get: if isAuthenticated() && isValidId(sessionId) && (
        resource.data.learnerUid == request.auth.uid ||
        resource.data.mentorUid == request.auth.uid
      );
      allow list: if isAuthenticated() && (
        resource.data.learnerUid == request.auth.uid ||
        resource.data.mentorUid == request.auth.uid
      );
      allow create: if isAuthenticated() && isValidId(sessionId)
        && request.resource.data.learnerUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && isValidId(sessionId) && (
        resource.data.learnerUid == request.auth.uid ||
        resource.data.mentorUid == request.auth.uid
      );
    }

    // Notifications (recipient-scoped)
    match /notifications/{notifId} {
      allow get: if isAuthenticated() && isValidId(notifId)
        && (resource.data.userId == request.auth.uid || (isPlatformOwner() && resource.data.userId == 'yamsaniruhan@gmail.com'));
      allow list: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || (isPlatformOwner() && resource.data.userId == 'yamsaniruhan@gmail.com'));
      allow create: if isAuthenticated() && isValidId(notifId)
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && isValidId(notifId)
        && (resource.data.userId == request.auth.uid || (isPlatformOwner() && resource.data.userId == 'yamsaniruhan@gmail.com'));
    }

    // Gamification rules and badges (server-managed catalog)
    match /gamification/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Marketplace courses & reviews
    match /marketplace/{courseId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidId(courseId)
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() <= 200;
      allow update, delete: if isAuthenticated() && isValidId(courseId)
        && resource.data.creatorUid == request.auth.uid;

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isAuthenticated() && isValidId(reviewId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.rating is number
          && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
        allow update, delete: if isAuthenticated() && isValidId(reviewId)
          && resource.data.userId == request.auth.uid;
      }
    }

    // Study Room Validation Blueprints (never allow password/passwordHash fields)
    function isValidStudyRoom(data, roomId) {
      return data.keys().hasAll(['id', 'title', 'topic', 'color', 'visibility', 'roomCode', 'hostUid', 'createdAt'])
        && data.keys().hasOnly(['id', 'title', 'topic', 'color', 'visibility', 'roomCode', 'hostUid', 'hostName', 'memberCount', 'timer', 'activePoll', 'createdAt', 'updatedAt'])
        && data.id == roomId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 80
        && data.topic is string && data.topic.size() >= 1 && data.topic.size() <= 120
        && data.color is string && data.color in ['indigo', 'amber', 'rose', 'purple', 'emerald']
        && data.visibility is string && data.visibility in ['public', 'private']
        && data.roomCode is string && data.roomCode.size() >= 4 && data.roomCode.size() <= 16 && data.roomCode.matches('^[A-Z0-9\\-]+$')
        && data.hostUid is string && data.hostUid.size() >= 1 && data.hostUid.size() <= 128
        && (!('hostName' in data) || (data.hostName is string && data.hostName.size() <= 80))
        && (!('memberCount' in data) || (data.memberCount is number && data.memberCount >= 0 && data.memberCount <= 10000))
        && data.createdAt is string && data.createdAt.size() <= 40
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 40));
    }

    function isValidStudyRoomInvite(data) {
      return data.keys().hasAll(['roomId', 'roomCode', 'hostUid', 'visibility', 'createdAt'])
        && data.keys().hasOnly(['roomId', 'roomCode', 'hostUid', 'visibility', 'createdAt'])
        && isValidId(data.roomId)
        && data.roomCode is string && data.roomCode.size() >= 4 && data.roomCode.size() <= 16 && data.roomCode.matches('^[A-Z0-9\\-]+$')
        && data.hostUid == request.auth.uid
        && data.visibility == 'private'
        && data.createdAt is string && data.createdAt.size() <= 40;
    }

    function isValidStudyRoomMember(data, memberUid) {
      return data.keys().hasAll(['userId', 'displayName', 'joinedAt'])
        && data.keys().hasOnly(['userId', 'displayName', 'inviteKey', 'joinedAt'])
        && data.userId == memberUid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.joinedAt is string && data.joinedAt.size() <= 40
        && (!('inviteKey' in data) || (data.inviteKey is string && data.inviteKey.size() <= 128));
    }

    function isValidStudyRoomMessage(data, roomId, messageId) {
      return data.keys().hasAll(['id', 'roomId', 'senderUid', 'user', 'text', 'visibility', 'createdAt'])
        && data.keys().hasOnly(['id', 'roomId', 'senderUid', 'user', 'text', 'visibility', 'createdAt'])
        && data.id == messageId
        && data.roomId == roomId
        && data.senderUid == request.auth.uid
        && data.user is string && data.user.size() >= 1 && data.user.size() <= 80
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 600
        && data.visibility is string && data.visibility in ['public', 'private']
        && data.createdAt is string && data.createdAt.size() <= 40;
    }

    // Collaborative Study Rooms (Public & Private)
    match /study_rooms/{roomId} {
      allow get: if isValidId(roomId) && (
        resource.data.visibility == 'public' ||
        (isAuthenticated() && (
          resource.data.hostUid == request.auth.uid ||
          exists(/databases/$(database)/documents/study_rooms/$(roomId)/members/$(request.auth.uid))
        ))
      );
      allow list: if resource.data.visibility == 'public' || (isAuthenticated() && resource.data.hostUid == request.auth.uid);
      allow create: if isAuthenticated()
        && isValidId(roomId)
        && isValidStudyRoom(request.resource.data, roomId)
        && request.resource.data.hostUid == request.auth.uid;
      allow update: if isAuthenticated()
        && isValidId(roomId)
        && isValidStudyRoom(request.resource.data, roomId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.visibility == resource.data.visibility
        && request.resource.data.roomCode == resource.data.roomCode
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          (resource.data.hostUid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'topic', 'color', 'timer', 'activePoll', 'memberCount', 'updatedAt'])) ||
          ((resource.data.visibility == 'public' || exists(/databases/$(database)/documents/study_rooms/$(roomId)/members/$(request.auth.uid))) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['timer', 'activePoll', 'memberCount', 'updatedAt']))
        );
      allow delete: if isAuthenticated() && isValidId(roomId) && resource.data.hostUid == request.auth.uid;

      match /members/{memberUid} {
        allow get: if isOwner(memberUid) && isValidId(roomId);
        allow list: if isAuthenticated() && resource.data.userId == request.auth.uid;
        allow create, update: if isOwner(memberUid)
          && isValidId(roomId)
          && isValidStudyRoomMember(request.resource.data, memberUid)
          && exists(/databases/$(database)/documents/study_rooms/$(roomId))
          && (
            get(/databases/$(database)/documents/study_rooms/$(roomId)).data.visibility == 'public' ||
            get(/databases/$(database)/documents/study_rooms/$(roomId)).data.hostUid == request.auth.uid ||
            (
              'inviteKey' in request.resource.data
              && isValidId(request.resource.data.inviteKey)
              && exists(/databases/$(database)/documents/study_room_invites/$(request.resource.data.inviteKey))
              && get(/databases/$(database)/documents/study_room_invites/$(request.resource.data.inviteKey)).data.roomId == roomId
            )
          );
        allow delete: if isOwner(memberUid) && isValidId(roomId);
      }

      match /messages/{messageId} {
        allow get: if isValidId(roomId) && isValidId(messageId)
          && exists(/databases/$(database)/documents/study_rooms/$(roomId))
          && (
            get(/databases/$(database)/documents/study_rooms/$(roomId)).data.visibility == 'public' ||
            (isAuthenticated() && (
              get(/databases/$(database)/documents/study_rooms/$(roomId)).data.hostUid == request.auth.uid ||
              exists(/databases/$(database)/documents/study_rooms/$(roomId)/members/$(request.auth.uid))
            ))
          );
        allow list: if resource.data.visibility == 'public' || (isAuthenticated() && resource.data.senderUid == request.auth.uid);
        allow create: if isAuthenticated()
          && isValidId(roomId)
          && isValidId(messageId)
          && isValidStudyRoomMessage(request.resource.data, roomId, messageId)
          && exists(/databases/$(database)/documents/study_rooms/$(roomId))
          && request.resource.data.visibility == get(/databases/$(database)/documents/study_rooms/$(roomId)).data.visibility
          && (
            get(/databases/$(database)/documents/study_rooms/$(roomId)).data.visibility == 'public' ||
            get(/databases/$(database)/documents/study_rooms/$(roomId)).data.hostUid == request.auth.uid ||
            exists(/databases/$(database)/documents/study_rooms/$(roomId)/members/$(request.auth.uid))
          );
        allow update: if false;
        allow delete: if isAuthenticated() && isValidId(roomId) && isValidId(messageId) && resource.data.senderUid == request.auth.uid;
      }
    }

    // Hash-keyed private room invites (never listable; requires knowing code + password to derive inviteKey)
    match /study_room_invites/{inviteKey} {
      allow get: if isAuthenticated() && isValidId(inviteKey);
      allow list: if false;
      allow create: if isAuthenticated()
        && isValidId(inviteKey)
        && isValidStudyRoomInvite(request.resource.data)
        && exists(/databases/$(database)/documents/study_rooms/$(request.resource.data.roomId))
        && get(/databases/$(database)/documents/study_rooms/$(request.resource.data.roomId)).data.hostUid == request.auth.uid;
      allow update: if false;
      allow delete: if isAuthenticated() && isValidId(inviteKey) && resource.data.hostUid == request.auth.uid;
    }
  }
}
