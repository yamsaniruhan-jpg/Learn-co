rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && isValidId(userId) && request.auth.uid == userId;
    }

    function isPlatformOwner() {
      return isAuthenticated() && request.auth.token.email == 'yamsaniruhan@gmail.com';
    }

    function isValidPublicProfile(data, userId) {
      return data.userId == userId
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 120
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 1000))
        && (!('xp' in data) || (data.xp is number && data.xp >= 0 && data.xp <= 10000000))
        && (!('level' in data) || (data.level is number && data.level >= 1 && data.level <= 1000));
    }

    function isValidLeaderboardEntry(data, entryId) {
      return isValidId(entryId)
        && data.userId == request.auth.uid
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 120
        && data.xp is number && data.xp >= 0 && data.xp <= 10000000
        && data.level is number && data.level >= 1 && data.level <= 1000
        && (!('streak' in data) || (data.streak is number && data.streak >= 0 && data.streak <= 10000))
        && (!('streakDays' in data) || (data.streakDays is number && data.streakDays >= 0 && data.streakDays <= 10000));
    }

    // User private data
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && (!('role' in request.resource.data) || request.resource.data.role != 'admin');
      allow delete: if isOwner(userId);

      match /progress/{courseId} {
        allow read, write: if isOwner(userId) && isValidId(courseId);
      }

      match /spacedRepetition/{cardId} {
        allow read, write: if isOwner(userId) && isValidId(cardId);
      }

      match /{subcollection}/{docId} {
        allow read, write: if isOwner(userId) && isValidId(docId);
      }
    }

    // Public scholar profiles (no PII; owner-only writes)
    match /public_profiles/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) && isValidPublicProfile(request.resource.data, userId);
      allow delete: if isOwner(userId);
    }

    // Public cohort leaderboard (owner-only bounded writes)
    match /leaderboard/{entryId} {
      allow read: if true;
      allow create, update: if isOwner(entryId) && isValidLeaderboardEntry(request.resource.data, entryId);
      allow delete: if isOwner(entryId);
    }

    // Creator resources
    match /resources/{resourceId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidId(resourceId) && (
        request.resource.data.creatorId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
      allow update, delete: if isAuthenticated() && isValidId(resourceId) && (
        resource.data.creatorId == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );
    }

    // Mentors catalog (owner-only or platform owner writes)
    match /mentors/{mentorId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidId(mentorId)
        && (request.resource.data.userId == request.auth.uid || isPlatformOwner());
      allow update, delete: if isAuthenticated() && isValidId(mentorId)
        && (resource.data.userId == request.auth.uid || mentorId == request.auth.uid || isPlatformOwner());
    }

    // Mentor applications (applicant create/read own, platform owner full review access)
    match /mentor_applications/{applicationId} {
      allow get, list: if isAuthenticated() && (
        resource.data.applicantUid == request.auth.uid ||
        isPlatformOwner()
      );
      allow create: if isAuthenticated() && isValidId(applicationId)
        && request.resource.data.applicantUid == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.routedToEmail == 'yamsaniruhan@gmail.com'
        && request.resource.data.fullName is string && request.resource.data.fullName.size() <= 160
        && request.resource.data.bio is string && request.resource.data.bio.size() <= 4000;
      allow update, delete: if isPlatformOwner();
    }

    // Mentorship sessions (participant-scoped)
    match /sessions/{sessionId} {
      allow get: if isAuthenticated() && isValidId(sessionId) && (
        resource.data.learnerUid == request.auth.uid ||
        resource.data.mentorUid == request.auth.uid
      );
      allow list: if isAuthenticated() && (
        resource.data.learnerUid == request.auth.uid ||
        resource.data.mentorUid == request.auth.uid
      );
      allow create: if isAuthenticated() && isValidId(sessionId)
        && request.resource.data.learnerUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && isValidId(sessionId) && (
        resource.data.learnerUid == request.auth.uid ||
        resource.data.mentorUid == request.auth.uid
      );
    }

    // Notifications (recipient-scoped)
    match /notifications/{notifId} {
      allow get: if isAuthenticated() && isValidId(notifId)
        && (resource.data.userId == request.auth.uid || (isPlatformOwner() && resource.data.userId == 'yamsaniruhan@gmail.com'));
      allow list: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || (isPlatformOwner() && resource.data.userId == 'yamsaniruhan@gmail.com'));
      allow create: if isAuthenticated() && isValidId(notifId)
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && isValidId(notifId)
        && (resource.data.userId == request.auth.uid || (isPlatformOwner() && resource.data.userId == 'yamsaniruhan@gmail.com'));
    }

    // Gamification rules and badges (server-managed catalog)
    match /gamification/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Marketplace courses & reviews
    match /marketplace/{courseId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidId(courseId)
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() <= 200;
      allow update, delete: if isAuthenticated() && isValidId(courseId)
        && resource.data.creatorUid == request.auth.uid;

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isAuthenticated() && isValidId(reviewId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.rating is number
          && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
        allow update, delete: if isAuthenticated() && isValidId(reviewId)
          && resource.data.userId == request.auth.uid;
      }
    }
  }
}
