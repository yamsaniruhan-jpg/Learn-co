rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User private data
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      match /progress/{courseId} {
        allow read, write: if isOwner(userId);
      }

      match /spacedRepetition/{cardId} {
        allow read, write: if isOwner(userId);
      }

      match /{subcollection}/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Public scholar profiles & leaderboards
    match /public_profiles/{userId} {
      allow read: if true;
      allow write: if true;
    }

    match /leaderboard/{entryId} {
      allow read: if true;
      allow write: if true;
    }

    // Creator resources
    match /resources/{resourceId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.creatorId == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );
    }

    // Mentors catalog
    match /mentors/{mentorId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Mentorship sessions
    match /sessions/{sessionId} {
      allow read, write: if isAuthenticated();
    }

    // Notifications
    match /notifications/{notifId} {
      allow read, write: if isAuthenticated();
    }

    // Gamification rules and badges
    match /gamification/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Marketplace courses & reviews
    match /marketplace/{courseId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.creatorUid == request.auth.uid ||
        request.auth.uid != null
      );

      match /reviews/{reviewId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
    }

    // Default deny for unmapped documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
