{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with display name, bio, and avatar",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "email": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "displayName"]
    },
    "UserGamification": {
      "title": "UserGamification",
      "description": "User lifetime XP, level, daily streak, badges, and periodic XP metrics",
      "type": "object",
      "properties": {
        "xp": { "type": "number" },
        "level": { "type": "number" },
        "streak": { "type": "number" },
        "longestStreak": { "type": "number" },
        "badges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "badgeId": { "type": "string" },
              "earnedAt": { "type": "string" },
              "badgeName": { "type": "string" },
              "icon": { "type": "string" }
            },
            "required": ["badgeId", "badgeName", "icon"]
          }
        },
        "weeklyXP": { "type": "number" },
        "monthlyXP": { "type": "number" },
        "lastXpReset": { "type": "string" }
      },
      "required": ["xp", "level", "streak"]
    },
    "XpRules": {
      "title": "XpRules",
      "description": "Global XP scoring values for educational activities and achievements",
      "type": "object",
      "properties": {
        "completeLesson": { "type": "number" },
        "passQuiz": { "type": "number" },
        "perfectQuiz": { "type": "number" },
        "createCourse": { "type": "number" },
        "publishCourse": { "type": "number" },
        "dailyLogin": { "type": "number" },
        "streakBonus7": { "type": "number" },
        "streakBonus30": { "type": "number" },
        "reviewFlashcard": { "type": "number" },
        "mentorSession": { "type": "number" }
      },
      "required": ["completeLesson", "passQuiz", "perfectQuiz", "createCourse", "publishCourse"]
    },
    "Badge": {
      "title": "Badge",
      "description": "Earnable badge definitions with category, requirements, and rarity tiers",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "category": { "type": "string", "enum": ["learner", "creator", "social", "streak"] },
        "requirement": {
          "type": "object",
          "properties": {
            "type": { "type": "string" },
            "target": { "type": "number" },
            "metric": { "type": "string" }
          },
          "required": ["type", "target", "metric"]
        },
        "rarity": { "type": "string", "enum": ["common", "rare", "epic", "legendary"] }
      },
      "required": ["name", "description", "icon", "category", "requirement", "rarity"]
    },
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "Public cohort standing entry",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "xp": { "type": "number" },
        "level": { "type": "number" },
        "streak": { "type": "number" },
        "tier": { "type": "string" },
        "rank": { "type": "number" }
      },
      "required": ["userId", "displayName", "xp", "rank"]
    },
    "CourseProgress": {
      "title": "CourseProgress",
      "description": "User course progress, lesson completion, quiz scores, and study metrics",
      "type": "object",
      "properties": {
        "courseId": { "type": "string" },
        "title": { "type": "string" },
        "completedLessons": { "type": "number" },
        "totalLessons": { "type": "number" },
        "percentage": { "type": "number" },
        "currentLesson": { "type": "string" },
        "lastStudied": { "type": "string" },
        "streakDays": { "type": "number" },
        "timeSpentMinutes": { "type": "number" }
      },
      "required": ["courseId", "title", "completedLessons", "totalLessons", "percentage"]
    },
    "SpacedRepetitionCard": {
      "title": "SpacedRepetitionCard",
      "description": "User spaced repetition flashcards with SM-2 interval and ease scheduling",
      "type": "object",
      "properties": {
        "topic": { "type": "string" },
        "question": { "type": "string" },
        "answer": { "type": "string" },
        "easeFactor": { "type": "number" },
        "interval": { "type": "number" },
        "repetitions": { "type": "number" },
        "nextReview": { "type": "string" },
        "lastReviewed": { "type": "string" }
      },
      "required": ["topic", "question", "answer", "easeFactor", "interval", "repetitions"]
    },
    "Mentor": {
      "title": "Mentor",
      "description": "Registered academic and domain mentors available for booking",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "status": { "type": "string" },
        "subjects": { "type": "array", "items": { "type": "string" } },
        "levels": { "type": "array", "items": { "type": "string" } },
        "specialties": { "type": "array", "items": { "type": "string" } },
        "rating": { "type": "number" },
        "totalSessions": { "type": "number" }
      },
      "required": ["name", "status", "subjects"]
    },
    "MentorApplication": {
      "title": "MentorApplication",
      "description": "Formal mentor accreditation applications submitted by learners and routed to platform owner",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "applicantUid": { "type": "string" },
        "applicantEmail": { "type": "string" },
        "fullName": { "type": "string" },
        "degree": { "type": "string" },
        "institution": { "type": "string" },
        "subjectId": { "type": "string" },
        "experienceYears": { "type": "number" },
        "capacity": { "type": "number" },
        "hourlyRate": { "type": "number" },
        "bio": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED"] },
        "routedToEmail": { "type": "string" },
        "reviewerEmail": { "type": "string" },
        "reviewerNote": { "type": "string" },
        "reviewedAt": { "type": "string" },
        "submittedAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["applicantUid", "applicantEmail", "fullName", "degree", "institution", "subjectId", "status", "routedToEmail"]
    },
    "MentorshipSession": {
      "title": "MentorshipSession",
      "description": "Scheduled 1-on-1 mentorship bookings between learners and mentors",
      "type": "object",
      "properties": {
        "learnerUid": { "type": "string" },
        "mentorId": { "type": "string" },
        "date": { "type": "string" },
        "duration": { "type": "number" },
        "topic": { "type": "string" },
        "goals": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["learnerUid", "mentorId", "date", "topic", "status"]
    },
    "Notification": {
      "title": "Notification",
      "description": "System and session notifications for users and mentors",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "sessionId": { "type": "string" },
        "message": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "type", "message", "read"]
    },
    "MarketplaceCourse": {
      "title": "MarketplaceCourse",
      "description": "Published public courses in the LearnCo marketplace",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "subject": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "creatorUid": { "type": "string" },
        "creatorName": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "totalLessons": { "type": "number" },
        "totalModules": { "type": "number" },
        "estimatedHours": { "type": "number" },
        "difficulty": { "type": "string", "enum": ["beginner", "intermediate", "advanced"] },
        "rating": { "type": "number" },
        "ratingCount": { "type": "number" },
        "enrolledCount": { "type": "number" },
        "price": { "type": "number" },
        "status": { "type": "string", "enum": ["published", "draft", "archived"] },
        "publishedAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "subject", "creatorUid", "status"]
    },
    "MarketplaceReview": {
      "title": "MarketplaceReview",
      "description": "User ratings and reviews for marketplace courses",
      "type": "object",
      "properties": {
        "courseId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "rating", "comment"]
    },
    "StreakSummary": {
      "title": "StreakSummary",
      "description": "Synchronized daily study streak history, heatmap activity log, and freeze shields",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "currentStreak": { "type": "number" },
        "longestStreak": { "type": "number" },
        "lastActiveDate": { "type": "string", "maxLength": 10, "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "freezeDaysRemaining": { "type": "number" },
        "streakHistory": { "type": "array", "items": { "type": "string" } },
        "updatedAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["userId", "currentStreak", "longestStreak", "lastActiveDate"]
    },
    "StudyRoom": {
      "title": "StudyRoom",
      "description": "Public or private collaborative STEM study room metadata, timer state, and polls (never stores plaintext passwords or hashes)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "topic": { "type": "string", "minLength": 1, "maxLength": 120 },
        "color": { "type": "string", "enum": ["indigo", "amber", "rose", "purple", "emerald"] },
        "visibility": { "type": "string", "enum": ["public", "private"] },
        "roomCode": { "type": "string", "minLength": 4, "maxLength": 16, "pattern": "^[A-Z0-9\\-]+$" },
        "hostUid": { "type": "string", "maxLength": 128 },
        "hostName": { "type": "string", "maxLength": 80 },
        "memberCount": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 40 },
        "updatedAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "title", "topic", "color", "visibility", "roomCode", "hostUid", "createdAt"]
    },
    "StudyRoomInvite": {
      "title": "StudyRoomInvite",
      "description": "Opaque SHA-256 keyed lookup mapping (normalized roomCode + password) to private roomId; list queries are denied",
      "type": "object",
      "properties": {
        "roomId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "roomCode": { "type": "string", "minLength": 4, "maxLength": 16, "pattern": "^[A-Z0-9\\-]+$" },
        "hostUid": { "type": "string", "maxLength": 128 },
        "visibility": { "type": "string", "enum": ["private"] },
        "createdAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["roomId", "roomCode", "hostUid", "visibility", "createdAt"]
    },
    "StudyRoomMember": {
      "title": "StudyRoomMember",
      "description": "Verified study room membership record proving inviteKey authorization for private rooms",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "inviteKey": { "type": "string", "maxLength": 128 },
        "joinedAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["userId", "displayName", "joinedAt"]
    },
    "StudyRoomMessage": {
      "title": "StudyRoomMessage",
      "description": "Persistent chat message inside a collaborative study room",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "roomId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderUid": { "type": "string", "maxLength": 128 },
        "user": { "type": "string", "maxLength": 80 },
        "text": { "type": "string", "minLength": 1, "maxLength": 600 },
        "visibility": { "type": "string", "enum": ["public", "private"] },
        "createdAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "roomId", "senderUid", "user", "text", "visibility", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private user profile and settings"
    },
    "/users/{userId}/gamification": {
      "schema": "UserGamification",
      "description": "Private gamification status, lifetime XP, streak, and badges"
    },
    "/users/{userId}/streak/{docId}": {
      "schema": "StreakSummary",
      "description": "User streak history, heatmap daily activities, and freeze shield sync state"
    },
    "/gamification/xpRules": {
      "schema": "XpRules",
      "description": "Global XP scoring configuration for lessons, quizzes, creation, and streaks"
    },
    "/gamification/badges/{badgeId}": {
      "schema": "Badge",
      "description": "Catalog of earnable achievement badges"
    },
    "/users/{userId}/progress/{courseId}": {
      "schema": "CourseProgress",
      "description": "User course progress and learning milestones"
    },
    "/users/{userId}/spacedRepetition/{cardId}": {
      "schema": "SpacedRepetitionCard",
      "description": "User spaced repetition flashcards with review scheduling"
    },
    "/mentors/{mentorId}": {
      "schema": "Mentor",
      "description": "Mentor profile with subjects, specialties, and ratings"
    },
    "/mentor_applications/{applicationId}": {
      "schema": "MentorApplication",
      "description": "Formal mentor applications routed directly to yamsaniruhan@gmail.com"
    },
    "/sessions/{sessionId}": {
      "schema": "MentorshipSession",
      "description": "Mentorship booking session between a learner and a mentor"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User and mentor alerts and session notifications"
    },
    "/public_profiles/{userId}": {
      "schema": "UserProfile",
      "description": "Public scholar profile details"
    },
    "/leaderboard/{entryId}": {
      "schema": "LeaderboardEntry",
      "description": "Public weekly and all-time leaderboard standings"
    },
    "/marketplace/{courseId}": {
      "schema": "MarketplaceCourse",
      "description": "Public courses published by creators on the LearnCo marketplace"
    },
    "/marketplace/{courseId}/reviews/{reviewId}": {
      "schema": "MarketplaceReview",
      "description": "Ratings and reviews for published marketplace courses"
    },
    "/study_rooms/{roomId}": {
      "schema": "StudyRoom",
      "description": "Public and private STEM collaborative study rooms synced with Firestore"
    },
    "/study_room_invites/{inviteKey}": {
      "schema": "StudyRoomInvite",
      "description": "Hash-keyed private room invite verification records (get-only, never listable)"
    },
    "/study_rooms/{roomId}/members/{userId}": {
      "schema": "StudyRoomMember",
      "description": "Verified study room member access records"
    },
    "/study_rooms/{roomId}/messages/{messageId}": {
      "schema": "StudyRoomMessage",
      "description": "Study room collaboration chat messages"
    }
  }
}
