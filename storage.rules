rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Public objects may be read, but ordinary clients must not overwrite or
    // delete shared content. Trusted server/admin uploads bypass these rules.
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
